# ============================================================================
# Private Tarot — environment template
# Copy to .env.production (chmod 600). Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ ever reach browser JavaScript;
# no secret may carry that prefix.
# ============================================================================

# Public configuration (server reads; expose deliberately if needed)
APP_DOMAIN=tarot.example.com
APP_ORIGIN=https://tarot.example.com
NODE_ENV=production

# Database
POSTGRES_PASSWORD=replace-with-random-long-secret
DATABASE_URL=postgresql://tarot:replace-with-urlencoded-password@postgres:5432/tarot

# Access / admin
# Generate secrets with: openssl rand -base64 48
AUTH_SIGNING_SECRET=replace-with-random-48-byte-secret
READING_TICKET_KEY_CURRENT=replace-with-random-32-byte-key-base64
READING_TICKET_KEY_ID=v1
# Optional previous ticket keys for rotation windows, comma-separated id:key pairs
# READING_TICKET_KEYS_PREVIOUS=v0:base64key
RATE_LIMIT_PEPPER=replace-with-random-48-byte-secret

# Access/admin credential hashes normally live in the database after bootstrap.
# Bootstrap variables let the very first boot verify codes before the settings
# row exists; run `npm run admin:generate-access-code` to produce them.
# BOOTSTRAP_ACCESS_CODE_HASH=argon2id-hash
# BOOTSTRAP_ADMIN_SECRET_HASH=argon2id-hash

# OpenAI (server-side only; never exposed to the client bundle)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS_FOCUSED=1400
OPENAI_MAX_OUTPUT_TOKENS_DEEP=2200
OPENAI_MAX_OUTPUT_TOKENS_COMPREHENSIVE=3000
OPENAI_STORE=false
# Pricing used for application-side estimates — verify at deployment/model change:
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.02
OPENAI_OUTPUT_USD_PER_MILLION=1.20

# Budget defaults (admin can change at runtime; these seed app_settings)
AI_ENABLED=true
AI_DAILY_BUDGET_USD=2.00
AI_MONTHLY_BUDGET_USD=30.00
AI_MAX_NORMAL_READING_USD=0.05
AI_MAX_REPAIR_USD=0.05
AI_PER_INSTALL_HOURLY=6
AI_PER_INSTALL_DAILY=20
AI_GLOBAL_CONCURRENCY=3

# Reading ticket
READING_TICKET_TTL_MINUTES=15

# Sharing
SHARE_TTL_DAYS=90
SHARE_MAX_CIPHERTEXT_BYTES=65536

# Privacy/logging
LOG_LEVEL=info
REQUEST_BODY_LOGGING=false
NEXT_TELEMETRY_DISABLED=1
